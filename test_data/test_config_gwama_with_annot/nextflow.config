includeConfig 'gwama_meta.config'

profiles {
    cluster {
        process.executor = 'lsf'
        process.queue = 'epistasis_normal'
        process.memory = '15GB'
    	process.container = 'gwama_meta.sif'
        singularity.enabled = true
        singularity.runOptions = '-B /project/'
    }
}
